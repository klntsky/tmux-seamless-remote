#!/usr/bin/env bash
set -euo pipefail

plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source "$plugin_dir/lib/peer.sh"
direction=${1:?missing direction}
destination=${2:?missing tmux pane}

case "$direction" in
  left|down|up|right) ;;
  *) exit 2 ;;
esac
[[ "$destination" =~ ^%[0-9]+$ ]] || exit 2

source_pane=$(tmux list-panes -t "$destination" -f '#{pane_last}' -F '#{pane_id}')
[[ "$source_pane" =~ ^%[0-9]+$ ]] || exit 0

destination_peer=$(tsr_peer_for_pane "$destination" || true)
[ -n "$destination_peer" ] || exit 0

read -r source_x source_y source_width source_height <<< "$(
  tmux display-message -p -t "$source_pane" \
    '#{pane_left} #{pane_top} #{pane_width} #{pane_height}'
)"
reference_x=$(awk "BEGIN { print $source_x + $source_width / 2 }")
reference_y=$(awk "BEGIN { print $source_y + $source_height / 2 }")

read -r destination_target destination_helper destination_socket destination_session \
  <<< "$destination_peer"
state=$(tsr_remote_call "$destination_target" "$destination_helper" "$destination_socket" \
  "$destination_session" state "$direction" || true)
[ "$(sed -n '1{s/ .*//;p;}' <<< "$state")" = STATE ] || exit 0

read -r destination_x destination_y destination_width destination_height <<< "$(
  tmux display-message -p -t "$destination" \
    '#{pane_left} #{pane_top} #{pane_width} #{pane_height}'
)"
remote_pane=$(awk -v direction="$direction" \
  -v point_x="$reference_x" -v point_y="$reference_y" \
  -v dx="$destination_x" -v dy="$destination_y" \
  -v dw="$destination_width" -v dh="$destination_height" \
  -f "$plugin_dir/lib/remote-edge.awk" <<< "$state")

[ -z "$remote_pane" ] || tsr_remote_call "$destination_target" "$destination_helper" \
  "$destination_socket" "$destination_session" select "$remote_pane" >/dev/null || true
